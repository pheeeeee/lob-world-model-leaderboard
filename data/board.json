 "metrics": [
  {
   "metric_id": "sided_w1",
   "primary_output": "sided_w1",
   "semantic_version": "2.0.0",
   "direction": "lower_is_better",
   "unit": "ticks",
   "summary": "Per-side shape-only 1-D Wasserstein-1 (closed-form CDF-difference, no OT solver) between predicted and realized order-flow histograms, convex-combined across bid/ask. Draws are averaged per sample; samples are averaged for the dataset value.",
   "outputs": [
    "sided_w1",
    "sided_w1_bid",
    "sided_w1_ask"
   ]
  },
  {
   "metric_id": "energy_score",
   "primary_output": "energy_score",
   "semantic_version": "1.0.0",
   "direction": "lower_is_better",
   "unit": "dimensionless",
   "summary": "A PROPER scoring rule for the predicted next-window flow DISTRIBUTION: ES(P,y) = E rho(X,y) - 0.5 E rho(X,X'), with rho a negative-type metric built from the project's shape/mass decomposition (1-D Wasserstein-1 on the normalized side shape, scaled by kappa, plus beta * |log1p mass| difference). Unlike every other metric on this board — all of which average a pairwise distance over draws and are therefore minimized by a collapsed point forecast — the energy score rewards honest dispersion: es_diversity_term going to zero exposes mode collapse that sided_w1 and full_field_ot cannot see. Needs R >= 2 draws to estimate the diversity term; a single draw is scored as the exact energy score of a point-mass forecast and counted separately.",
   "outputs": [
    "energy_score",
    "energy_score_bid",
    "energy_score_ask",
    "es_target_term",
    "es_diversity_term"
   ]
  },
  {
   "metric_id": "energy_score_l2",
   "primary_output": "energy_score_l2",
   "semantic_version": "1.0.0",
   "direction": "lower_is_better",
   "unit": "log1p_shares",
   "summary": "The HELD-OUT proper scoring rule: the textbook multivariate energy score (Gneiting & Raftery 2007, section 4.3) with the Euclidean norm on the per-bin log1p volume field of both sides, ES(P,y) = E rho(X,y) - 0.5 E rho(X,X'), rho = ||z(X) - z(Y)||_2 / sqrt(2 B_norm). No optimal transport, no tick geometry, no shape/mass split and no exchange rate: it shares nothing with the GRPO reward or with energy_score beyond the proper-scoring form, so a gain that appears here as well cannot be an artefact of the transport geometry a model was trained on. STRICTLY proper for the joint law of the two sides (Euclidean = strong negative type). Its target term is the mean over draws of sqrt(log1p_flow_mse): it is to log1p_flow_mse what energy_score is to sided_w1 + ntve. Always defined; R = 1 is scored as the exact energy score of a point-mass forecast. Blind to HOW FAR a misplaced spike is (one tick or a hundred cost the same), which is why it is a held-out check and not a headline column.",
   "outputs": [
    "energy_score_l2",
    "energy_score_l2_bid",
    "energy_score_l2_ask",
    "es_l2_target_term",
    "es_l2_diversity_term"
   ]
  },
  {
   "metric_id": "full_field_ot",
   "primary_output": "d_full",
   "semantic_version": "1.0.0",
   "direction": "lower_is_better",
   "unit": "share_ticks",
   "summary": "The project's headline metric: a mass-aware optimal-transport comparison of the whole unnormalized volume-at-price field, reported with the shape/mass decomposition that produces it. d_full = min(m_P, m_Q) * d_shape + lam * d_mass (share*ticks) is the cost of an explicit partial-transport plan — move the common mass into the right shape, then create/destroy the residual at lam ticks/share — and upper-bounds the true TV-penalized unbalanced OT cost. Closed form via the 1-D CDF-difference identity, no OT solver. Unlike sided_w1 (shape-only) it is TOTAL: defined even when one side is empty, because zero common mass incurs no transport cost. Draws are averaged per sample (a point functional, not a proper score — see energy_score); samples are averaged for the dataset value.",
   "outputs": [
    "d_full",
    "d_full_bid",
    "d_full_ask",
    "d_shape",
    "d_shape_bid",
    "d_shape_ask",
    "d_mass",
    "d_mass_rel"
   ]
  },
  {
   "metric_id": "log1p_flow_mse",
   "primary_output": "log1p_flow_mse",
   "semantic_version": "1.0.0",
   "direction": "lower_is_better",
   "unit": "log1p_shares_sq",
   "summary": "Masked-MSE training objective as an evaluation metric: mean squared error between predicted and realized flow histograms in log1p volume space, summed over the union tick support, normalized by a fixed bin count, both sides jointly. Draws are averaged per sample; samples are averaged for the dataset value. Definition doc pins the exact formula and the three deliberate deviations from the in-training loss.",
   "outputs": [
    "log1p_flow_mse",
    "log1p_flow_mse_bid",
    "log1p_flow_mse_ask"
   ]
  },
  {
   "metric_id": "norm_total_volume_error",
   "primary_output": "ntve",
   "semantic_version": "1.0.0",
   "direction": "lower_is_better",
   "unit": "fraction",
   "summary": "Per-side normalized total-volume error |sum(pred) - sum(target)| / sum(target) — the scale axis complementing the shape-only sided_w1. Draws are averaged per side; sides are macro-averaged (0.5/0.5, both must be defined); samples are averaged for the dataset value. A zero-mass target side with predicted mass is undefined (never a silent cap or NaN).",
   "outputs": [
    "ntve",
    "ntve_bid",
    "ntve_ask"
   ]
  },
  {
   "metric_id": "rank_calibration",
   "primary_output": "rank_calibration",
   "semantic_version": "1.0.0",
   "direction": "lower_is_better",
   "unit": "dimensionless",
   "summary": "The rank-histogram (Talagrand / PIT) calibration diagnostic: the rank of the realization among the R draws is uniform on {0..R} iff the ensemble is drawn from the correct predictive law. Reports the reliability index normalized to [0,1] and, more usefully, the SIGNED coverage_error — negative means the realization falls outside the ensemble range too often (over-confident, spread too narrow), positive means too wide. Ties are broken by a deterministic seeded randomization, so the number is reproducible and models share tie-breaks. CORPUS-level: needs the whole dataset and a constant draw count. NOT a quality score — a climatological forecast that ignores the conditioning scores a perfect 0 — so read it against energy_score and total_volume_crps, never alone.",
   "outputs": [
    "rank_calibration",
    "reliability_index",
    "coverage_inside",
    "coverage_nominal",
    "coverage_error"
   ]
  },
  {
   "metric_id": "total_volume_crps",
   "primary_output": "total_volume_crps",
   "semantic_version": "1.0.0",
   "direction": "lower_is_better",
   "unit": "log1p_shares",
   "summary": "The Continuous Ranked Probability Score of the predicted per-side TOTAL VOLUME — the mass axis of the flow field scored as a distribution rather than as a point. CRPS = E|X - y| - 0.5 E|X - X'| is the 1-D case of the energy score and, because the real line is of STRONG negative type, it is STRICTLY proper: the expected score is uniquely minimized by the true conditional law of the volume. Stands to norm_total_volume_error exactly as energy_score stands to sided_w1. Total (no UNDEFINED path): an empty side scores log1p(0) = 0, not a gap. crps_spread_term exposes a model that predicts one volume per window.",
   "outputs": [
    "total_volume_crps",
    "total_volume_crps_bid",
    "total_volume_crps_ask",
    "crps_target_term",
    "crps_spread_term"
   ]
  }
 ],
